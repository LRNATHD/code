  28              	
  29              	    if(s == DISABLE)
  30              	    {
  31              	        
  32              	        adj &= ~RB_DCDC_CHARGE;
  33              	        plan &= ~(RB_PWR_DCDC_EN | RB_PWR_DCDC_PRE); // 旁路 DC/DC
